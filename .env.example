# Copy these into Dokploy > Compose service > Environment. Never commit real values.
# Generate each secret with: openssl rand -hex 32

# Required
DOMAIN=social.yourdomain.com
JWT_SECRET=
DB_PASSWORD=
TEMPORAL_PASSWORD=

# Set to true after you create your own account
DISABLE_REGISTRATION=false

# TikTok (redirect URI: https://<DOMAIN>/integrations/social/tiktok)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Optional channels
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
OPENAI_API_KEY=
